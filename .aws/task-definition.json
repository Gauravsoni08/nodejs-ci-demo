{
    "family": "nodejs-ecs-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::683210040488:role/GitHubActions-ECS-Deploy",
    "containerDefinitions": [
        {
            "name": "nodejs-app",
            "image": "public.ecr.aws/docker/library/nginx:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "protocol": "tcp"
                }
            ]
        }
    ]
}